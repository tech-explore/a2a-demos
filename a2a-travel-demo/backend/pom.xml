<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>org.xplore.a2ademos</groupId>
  <artifactId>a2a-travel-demo</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>A2A Travel Planner Demo</name>

  <properties>
    <java.version>21</java.version>
    <a2a.sdk.version>1.3.0.Final</a2a.sdk.version>
    <!-- The A2A SDK is built against gson 2.14; Spring Boot 4.1 manages 2.13.2, so override it -->
    <gson.version>2.14.0</gson.version>
    <!-- same version Spring Boot 4.1.1 manages for protobuf-java -->
    <protobuf.version>4.35.1</protobuf.version>
  </properties>

  <modules>
    <module>a2a-spring-support</module>
    <module>flight-agent</module>
    <module>hotel-agent</module>
    <module>activities-agent</module>
    <module>orchestrator-agent</module>
    <!-- <module>e2e-tests</module> -->
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.a2aproject.sdk</groupId>
        <artifactId>a2a-java-sdk-bom</artifactId>
        <version>${a2a.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.xplore.a2ademos</groupId>
        <artifactId>a2a-spring-support</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
