<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xplore.a2ademos</groupId>
    <artifactId>a2a-travel-demo</artifactId>
    <version>1.0.0</version>
  </parent>

  <groupId>org.xplore.a2ademos</groupId>
  <artifactId>a2a-spring-support</artifactId>
  <version>1.0.0</version>
  <name>A2A Spring Boot support (server wiring + tracing)</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <!-- Boot 4: spring-boot-starter-web is deprecated; webmvc brings Tomcat, Spring MVC and Jackson 3 -->
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- A2A Java SDK: server side -->
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-server-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-transport-jsonrpc</artifactId>
      <version>${a2a.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-jsonrpc-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-spec-grpc</artifactId>
    </dependency>

    <!-- A2A Java SDK: client side (used by the orchestrator) -->
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-client</artifactId>
      <version>${a2a.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
      <version>${a2a.sdk.version}</version>
    </dependency>

    <!-- Declared "provided" inside the SDK, so we bring them ourselves -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
      <version>${protobuf.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
